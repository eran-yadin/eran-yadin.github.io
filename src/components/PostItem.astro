---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../site';
import { titleFromId } from '../lib/content';
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { description, date } = post.data;
const title = post.data.title ?? titleFromId(post.id);
---
<div class="list-item">
  <time datetime={date.toISOString()}>{formatDate(date)}</time>
  <div>
    <a href={`/posts/${post.id}/`}>{title}</a>
    {description && <p>{description}</p>}
  </div>
</div>
