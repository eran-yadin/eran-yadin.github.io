---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PostItem from '../../components/PostItem.astro';
import { getPosts, getProjects, getTags } from '../../lib/content';

export async function getStaticPaths() {
  const tags = await getTags();
  const posts = await getPosts();
  const projects = await getProjects();
  return [...tags.keys()].map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((n) => n.data.tags.includes(tag)),
      projects: projects.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts, projects } = Astro.props;
---
<Base title={`#${tag}`} description={`Projects and posts tagged ${tag}.`}>
  <p class="eyebrow">Tag</p>
  <h1>#{tag}</h1>

  {projects.length > 0 && (
    <section class="section">
      <div class="section-head"><h2>Projects</h2></div>
      <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
    </section>
  )}
  {posts.length > 0 && (
    <section class="section">
      <div class="section-head"><h2>Posts</h2></div>
      <div class="list">{posts.map((n) => <PostItem post={n} />)}</div>
    </section>
  )}
</Base>
