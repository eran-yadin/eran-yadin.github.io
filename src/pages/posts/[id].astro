---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Backlinks from '../../components/Backlinks.astro';
import { getPosts, getBacklinks, hrefOf, titleFromId } from '../../lib/content';
import { formatDate } from '../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  const backlinks = await getBacklinks();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, backlinks: backlinks.get(hrefOf(post)) ?? [] },
  }));
}

const { post, backlinks } = Astro.props;
const { description, date, updated, tags } = post.data;
const title = post.data.title ?? titleFromId(post.id);
const { Content } = await render(post);
---
<Base title={title} description={description} type="article">
  <header class="article-head">
    <p class="eyebrow">Post</p>
    <h1>{title}</h1>
    {description && <p class="lede">{description}</p>}
    <div class="meta">
      <span>Published <time datetime={date.toISOString()}>{formatDate(date)}</time></span>
      {updated && <span>· Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>}
    </div>
    {tags.length > 0 && <div class="tags" style="margin-top:.8rem">{tags.map((t) => <a class="tag" href={`/tags/${t}/`}>{t}</a>)}</div>}
  </header>

  <article class="prose">
    <Content />
  </article>

  <Backlinks links={backlinks} />
</Base>
